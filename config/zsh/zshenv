#!/bin/zsh
# This file is sourced rather than run, so the shebang is only here to stop
# editors and linters treating it as bash and flagging the zsh-only syntax.

# ------------------------------------------------------------------------------------------
# Prevent the MacOS /etc/zprofile running its path helper and adding all sorts
# of unnecessary nonsense to my path.

unsetopt global_rcs

# ------------------------------------------------------------------------------------------
# Decide whether this is a home or Ferocia machine, based on the hostname.

if [[ ${HOST%%.*} == fer-* ]] {
  export DOTFILES_ENV=ferocia
} else {
  export DOTFILES_ENV=home
}

# ------------------------------------------------------------------------------------------
# Build the path.
#
# We save some time by manually doing everything that would normally be done by
# `brew shellenv` and `mise activate zsh --shims`.
#
# OrbStack's shims and completions are listed here too, rather than left to the
# `source ~/.orbstack/shell/init.zsh` stanza its installer adds to ~/.zprofile.
# That stanza only runs for login shells, so docker goes missing in any other
# shell, and it sits outside this repo, so it wouldn't survive a new machine.

export HOMEBREW_PREFIX=/opt/homebrew
export HOMEBREW_CELLAR=/opt/homebrew/Cellar
export HOMEBREW_REPOSITORY=/opt/homebrew
export HOMEBREW_NO_ENV_HINTS=true

path=(
  $HOME/.local/share/mise/shims
  $HOMEBREW_PREFIX/bin
  $HOMEBREW_PREFIX/sbin
  /usr/bin
  /bin
  /usr/sbin
  /sbin
  $HOME/.local/bin
  $HOME/.orbstack/bin
)

fpath=(
  $HOMEBREW_PREFIX/share/zsh/site-functions(N)
  $HOMEBREW_PREFIX/share/zsh-completions(N)
  $HOME/.orbstack/shell/completions/zsh(N)
  $fpath
)

# ------------------------------------------------------------------------------------------
# Make Neovim my default editor.

if [[ -x $HOMEBREW_PREFIX/bin/nvim ]] {
  export EDITOR=$HOMEBREW_PREFIX/bin/nvim
}

# ------------------------------------------------------------------------------------------
# Set various helpful things for Ferocia.

if [[ -a $HOME/.zshenv-ferocia ]] {
  source $HOME/.zshenv-ferocia
}
