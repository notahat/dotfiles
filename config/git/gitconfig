# Global git settings, pulled in from ~/.config/git/config by an include that
# steps/git.bash sets up.
#
# Anything machine-specific belongs in ~/.config/git/config itself, not here.

[user]
	name = Pete Yandell
	email = pete@notahat.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA2BA/e0q3tXws2U27FUJYj0x+Td0muwZMdJtpJu5lAi

# Sign every commit with the SSH key above. 1Password holds the private key
# and does the signing, so the key never sits on disk. The allowed signers
# file maps that key to the email above, which lets git verify the
# signatures, for example in `git log --show-signature`.
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed-signers

# Name the first branch of a new repo main. Git's own default is still master.
[init]
	defaultBranch = main
