# Follow `source` statements into lib/, so the shared helpers get checked
# along with the scripts that use them, and the functions and variables they
# define are recognised as defined.
external-sources=true

# Resolve the paths in `# shellcheck source=` directives relative to the
# script doing the sourcing, rather than to wherever shellcheck was run from.
source-path=SCRIPTDIR

# Every named variable is written as ${name}, never $name, so the two forms
# don't mix. Positional parameters and specials like $1, $@ and $? stay bare.
enable=require-variable-braces
