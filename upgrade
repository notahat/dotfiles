#!/bin/bash

# shellcheck source=lib/dotfiles.bash
source "$(dirname "$0")/lib/dotfiles.bash"

echo_green "Upgrading homebrew packages..."
brew upgrade --yes

echo
echo_green "Upgrading mise tools..."
mise up

echo
echo_green "Upgrading Neovim plugins..."
nvim --headless "+Lazy! sync" +qa

echo
echo_green "Upgrading AI skills..."
DO_NOT_TRACK=1 npx --yes skills update --global --yes

echo
echo_green "Upgrade complete."
