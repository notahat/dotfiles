{
  "permissions": {
    "allow": ["Bash(./install:*)", "Bash(./upgrade)"]
  },
  "sandbox": {
    "excludedCommands": ["./install", "./install *", "./upgrade"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/format-file \"$(jq -r '.tool_input.file_path')\" || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
