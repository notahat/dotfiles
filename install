#!/bin/bash

# shellcheck source=lib/dotfiles.bash
source "$(dirname "$0")/lib/dotfiles.bash"

readonly STEPS=(
  macos homebrew mise      # Core system stuff
  ghostty zsh starship     # Terminal
  git ssh                  # Git & GitHub
  neovim zed editorconfig  # Editors
  bat
  herdr ai                 # AI stuff
)

# Which machine this is: home, or ferocia (my employer), whose machines have
# hostnames starting fer-. Only this script cares; the steps never read it.
if [[ $(hostname -s) == fer-* ]]; then
  DOTFILES_ENV=ferocia
else
  DOTFILES_ENV=home
fi
readonly DOTFILES_ENV

# Where the private, Ferocia-only overlay repo lives. It's cloned by hand, and
# only on Ferocia machines.
readonly FEROCIA_DIR="${HOME}/.dotfiles-ferocia"

# Prints how to run this script, and the steps it knows about.
function usage {
  echo "Usage: install [step]"
  echo
  echo "Set up this machine from the dotfiles. With no step, runs every step in"
  echo "order. With a step name, runs just that one."
  echo
  echo "Steps, in the order they run:"
  echo "  ${STEPS[*]}"
}

# Prints the path of a step's script. On a Ferocia machine, a step in the
# overlay's steps directory replaces the one here.
function find_step {
  local overlay_step="${FEROCIA_DIR}/steps/$1.bash"

  if [[ ${DOTFILES_ENV} == ferocia && -f ${overlay_step} ]]; then
    echo "${overlay_step}"
  else
    echo "${DOTFILES_DIR}/steps/$1.bash"
  fi
}

# Runs one step by name, saying where it came from. Exits with the usage
# message when there's no such step.
function run_step {
  local step
  step=$(find_step "$1")

  if [[ ! -f ${step} ]]; then
    echo_red "There's no step called \"$1\"." >&2
    echo >&2
    usage >&2
    exit 1
  fi

  echo
  if [[ ${step} == "${FEROCIA_DIR}"/* ]]; then
    echo_green "Configuring $1 (from .dotfiles-ferocia)..."
  else
    echo_green "Configuring $1..."
  fi
  "${step}"
}

# Runs every step, in order.
function run_all_steps {
  local step
  for step in "${STEPS[@]}"; do
    run_step "${step}"
  done
}

# Runs the step named on the command line, or all of them.
function main {
  if [[ $1 == "-h" || $1 == "--help" ]]; then
    usage
    exit 0
  fi

  if [[ ${DOTFILES_ENV} == ferocia && ! -d ${FEROCIA_DIR} ]]; then
    echo_red "Clone dotfiles-ferocia to ${FEROCIA_DIR} first." >&2
    exit 1
  fi

  if [[ -n $1 ]]; then
    run_step "$1"
  else
    run_all_steps
  fi

  echo
  echo_green "Install complete."
}

main "$@"
