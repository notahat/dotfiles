#!/bin/bash

set -o errexit

# shellcheck source=lib/dotfiles.bash
source "$(dirname "$0")/lib/dotfiles.bash"

steps_dir="$dotfiles_dir/steps"
steps=(macos ferocia homebrew mise zsh ssh git ghostty neovim rancher-desktop zed bat herdr claude copilot gemini)

# The PATH every step runs with. Each step is its own program, so this is the
# single place that puts the Homebrew and Mise binaries where the steps can
# find them. It mirrors what config/zsh/zshenv sets up for an interactive
# shell. Entries that don't exist yet on a fresh machine do no harm.
export PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/opt/homebrew/sbin:$PATH:$HOME/.local/bin"

# Runs a single step, complaining if there's no such thing.
function run_step {
  if [[ ! -f "$steps_dir/$1.bash" ]]; then
    echo_red "There's no step called \"$1\"."
    echo
    usage
  fi

  echo
  echo_green "Configuring $1..."
  "$steps_dir/$1.bash"
}

function run_all_steps {
  for step in "${steps[@]}"; do
    run_step "$step"
  done
}

function usage {
  echo "Usage:"
  echo "  export DOTFILES_ENV=home|ferocia"
  echo
  echo "Run all steps:"
  echo "  install"
  echo
  echo "Run a single step:"
  echo "  install [step name]"
  echo
  echo "Available steps: ${steps[*]}"
  exit 1
}

if [[ $DOTFILES_ENV != "home" && $DOTFILES_ENV != "ferocia" ]]; then usage; fi

if [[ $1 == "-h" || $1 == "--help" ]]; then
  usage
elif [[ -n $1 ]]; then
  run_step "$1"
else
  run_all_steps
fi

echo
echo_green "Install complete."
